{
  "name": "work-manager",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,green \"npm run dev --workspace=apps/client\" \"npm run dev --workspace=apps/server\"",
    "dev:client": "npm run dev --workspace=apps/client",
    "dev:server": "npm run dev --workspace=apps/server",
    "build": "npm run build --workspaces --if-present",
    "type-check": "tsc -b",
    "db:up": "docker compose --env-file project.env up -d",
    "db:down": "docker compose --env-file project.env down",
    "db:generate": "npm run db:generate --workspace=apps/server",
    "db:migrate": "npm run db:migrate --workspace=apps/server",
    "db:push": "npm run db:push --workspace=apps/server",
    "db:seed": "npm run db:seed --workspace=apps/server",
    "db:reset": "npm run db:reset --workspace=apps/server",
    "db:studio": "npm run db:studio --workspace=apps/server",
    "build:local": "npm run build:local --workspace=apps/client && npm run build --workspace=apps/server",
    "local:start": "./scripts/start-local.sh",
    "local:stop": "./scripts/stop-local.sh",
    "local:rebuild": "./scripts/rebuild.sh",
    "local:migrate": "npm run db:migrate:local --workspace=apps/server",
    "local:backup": "./scripts/backup-db.sh",
    "local:install": "./scripts/install-service.sh",
    "local:uninstall": "./scripts/uninstall-service.sh"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
