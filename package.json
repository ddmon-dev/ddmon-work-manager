{
  "name": "work-manager",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,green \"npm run dev --workspace=apps/client\" \"npm run dev --workspace=apps/server\"",
    "dev:start": "npm run db:up && concurrently -n client,server,studio -c cyan,green,magenta \"npm run dev --workspace=apps/client\" \"npm run dev --workspace=apps/server\" \"npm run db:studio --workspace=apps/server\"",
    "dev:stop": "npm run db:down",
    "dev:client": "npm run dev --workspace=apps/client",
    "dev:server": "npm run dev --workspace=apps/server",
    "build": "npm run build --workspaces --if-present",
    "type-check": "tsc -b",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "npm run db:generate --workspace=apps/server",
    "db:migrate": "npm run db:migrate --workspace=apps/server",
    "db:push": "npm run db:push --workspace=apps/server",
    "db:seed": "npm run db:seed --workspace=apps/server",
    "db:reset": "npm run db:reset --workspace=apps/server",
    "db:studio": "npm run db:studio --workspace=apps/server",
    "build:production": "npm run build:production --workspace=apps/client && npm run build --workspace=apps/server",
    "deploy": "git push origin main && cd ~/production/work-manager && git pull origin main && npm install && ./scripts/rebuild.sh",
    "production:start": "cd ~/production/work-manager && ./scripts/start-production.sh",
    "production:stop": "cd ~/production/work-manager && ./scripts/stop-production.sh",
    "production:rebuild": "cd ~/production/work-manager && ./scripts/rebuild.sh",
    "production:migrate": "cd ~/production/work-manager && npm run db:migrate:production --workspace=apps/server",
    "production:seed": "cd ~/production/work-manager && npm run db:seed:production --workspace=apps/server",
    "production:backup": "cd ~/production/work-manager && ./scripts/backup-db.sh",
    "production:install": "cd ~/production/work-manager && ./scripts/install-service.sh",
    "production:uninstall": "cd ~/production/work-manager && ./scripts/uninstall-service.sh",
    "db:pull-seed": "./scripts/pull-seed.sh"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
