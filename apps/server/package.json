{
  "name": "@packages/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env.local src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "db:generate": "node --env-file=../../.env.local ../../node_modules/.bin/drizzle-kit generate",
    "db:migrate": "node --env-file=../../.env.local ../../node_modules/.bin/drizzle-kit migrate",
    "db:push": "node --env-file=../../.env.local ../../node_modules/.bin/drizzle-kit push",
    "db:studio": "node --env-file=../../.env.local ../../node_modules/.bin/drizzle-kit studio",
    "db:seed": "tsx --env-file=../../.env.local src/db/seed.ts",
    "db:reset": "tsx --env-file=../../.env.local src/db/reset.ts && npm run db:migrate && npm run db:seed",
    "db:seed-demo": "tsx --env-file=../../.env.local src/db/seed-demo.ts",
    "db:reset-demo": "tsx --env-file=../../.env.local src/db/reset.ts && npm run db:migrate && npm run db:seed-demo"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.1",
    "@packages/schemas": "*",
    "@packages/utils": "*",
    "better-auth": "^1.4.19",
    "drizzle-orm": "^0.43.1",
    "hono": "^4.7.13",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.16.0",
    "drizzle-kit": "^0.31.1",
    "tsup": "^8.5.1",
    "tsx": "^4.19.4"
  }
}
