# Work Manager 환경변수 템플릿
# 사용: cp .env.local.example .env.local

# --- 공통 ---
DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:8002/work_manager
BETTER_AUTH_SECRET=your-secret-change-this-in-production
STORAGE_DIR=../../storage

# --- 개발 환경 (기본) ---
BETTER_AUTH_URL=http://localhost:8001
CLIENT_URL=http://localhost:8000
# 공개 빌드 에셋을 별도 전송 주소로 제공할 때만 설정 (빌드 시 적용)
# VITE_ASSET_BASE_URL=https://your-service.up.railway.app/
PORT=8001

# --- 운영 환경: 위 개발 섹션을 아래 값으로 교체 ---
# NODE_ENV=production
# BETTER_AUTH_URL=http://localhost:7070
# CLIENT_URL=http://localhost:7070
# PORT=7070
# SERVE_STATIC=true

# --- 선택 (누락 시 코드 기본값 사용: 100MB / 10MB) ---
# MAX_FILE_SIZE_MB=100
# MAX_EDITOR_IMAGE_SIZE_MB=10

# --- 데모 모드 (데모 배포 전용) ---
# DEMO_MODE=true            # 서버: 삭제·비밀번호 변경·비허용 확장자 업로드 차단 + 데모 로그인 라우트 활성화
# VITE_DEMO_MODE=true       # 클라이언트: 로그인 오버레이 등 데모 UI 활성화
# DEMO_USERNAME=demo        # 데모 로그인 대행 계정 (서버 전용, 클라이언트 비노출)
# DEMO_PASSWORD=change-me
# MAX_FILE_SIZE_MB=10       # 데모는 10MB 권장
